#!/usr/bin/env bash
# Puts quickbar's file chooser portal in place (docs/filechooser.md): the
# service and its D-Bus activation linked here, the .portal file copied to
# where xdg-desktop-portal reads them (which takes sudo), and portals.conf
# pointed at it. Run again after moving the repo.
set -euo pipefail

here="$(dirname "$(realpath "$0")")"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
data="${XDG_DATA_HOME:-$HOME/.local/share}"

mkdir -p "$config/systemd/user" "$data/dbus-1/services"
ln -sf "$here/quickbar-portal.service" "$config/systemd/user/"
ln -sf "$here/org.freedesktop.impl.portal.desktop.quickbar.service" "$data/dbus-1/services/"
systemctl --user daemon-reload
# The bus only reads new activation files when told to
busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig

sudo install -m 644 "$here/quickbar.portal" /usr/share/xdg-desktop-portal/portals/

conf="$config/xdg-desktop-portal/hyprland-portals.conf"
if grep -q '^org.freedesktop.impl.portal.FileChooser=' "$conf" 2>/dev/null; then
    sed -i 's/^org.freedesktop.impl.portal.FileChooser=.*/org.freedesktop.impl.portal.FileChooser=quickbar/' "$conf"
elif grep -q '^\[preferred\]' "$conf" 2>/dev/null; then
    sed -i '/^\[preferred\]/a org.freedesktop.impl.portal.FileChooser=quickbar' "$conf"
else
    mkdir -p "${conf%/*}"
    printf '[preferred]\norg.freedesktop.impl.portal.FileChooser=quickbar\n' >> "$conf"
fi

systemctl --user restart xdg-desktop-portal.service
echo "File chooser: quickbar"
