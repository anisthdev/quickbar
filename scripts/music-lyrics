#!/usr/bin/env python3
"""A song's lyrics, for the music menu's lyrics page, as JSON:

  {"timed": true, "lines": [{"time": 12.34, "text": "..."}, ...]}

FILE is the song as mpd names it, relative to its music_directory. tunes saves
lyrics beside the song: Title.lrc, timed, or Title.txt, plain, whose lines have
no "time". With neither, there are no lines. A timed gap (an empty line, or a
few notes) is one line of "♪".
"""
import json
import os
import re
import sys
from pathlib import Path

STAMP = re.compile(r"\[(\d+):(\d+(?:[.:]\d+)?)\]")
NOTES = "♪"


def music_dir():
    conf = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "mpd" / "mpd.conf"
    try:
        match = re.search(r'^\s*music_directory\s+"([^"]+)"', conf.read_text(), re.M)
    except OSError:
        match = None
    return Path(match[1]).expanduser() if match else Path.home() / "Music"


def timed(text):
    """An LRC's lines in order. A line can have several stamps, when it repeats."""
    offset = re.search(r"^\[offset:\s*([+-]?\d+)\]", text, re.M)
    shift = int(offset[1]) / 1000 if offset else 0
    lines = []
    for raw in text.splitlines():
        stamps = STAMP.findall(raw)
        words = STAMP.sub("", raw).strip()
        for minutes, seconds in stamps:
            when = int(minutes) * 60 + float(seconds.replace(":", "."))
            lines.append({"time": max(0, when + shift), "text": words if words.strip(NOTES + " ") else NOTES})
    lines.sort(key=lambda line: line["time"])
    return [line for i, line in enumerate(lines)
            if line["text"] != NOTES or i == 0 or lines[i - 1]["text"] != NOTES]


def lyrics(song):
    if song.with_suffix(".lrc").is_file():
        lines = timed(song.with_suffix(".lrc").read_text(errors="replace"))
        return {"timed": bool(lines), "lines": lines}
    if song.with_suffix(".txt").is_file():
        text = song.with_suffix(".txt").read_text(errors="replace")
        return {"timed": False, "lines": [{"text": line.strip()} for line in text.splitlines()]}
    return {"timed": False, "lines": []}


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    print(json.dumps(lyrics(music_dir() / sys.argv[1]), ensure_ascii=False))
