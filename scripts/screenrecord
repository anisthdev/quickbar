#!/usr/bin/env bash
# quickbar's screen recording (modules/Capture.qml): wl-screenrec to
# ~/Videos, with a tray icon (the tray CLI) showing how long it's been
# going: a click stops it, and its menu stops it, discards it or shows the
# recordings. Once saved, a notification with what to do with it next
# (scripts/capture-notify).
#   screenrecord screen    the focused screen
#   screenrecord region    a region picked with the mouse
#   screenrecord window    a window on this workspace picked with the mouse
#   screenrecord stop      stops a recording, saving it
#   screenrecord discard   stops a recording, deleting it

self="$(realpath "$0")"
# Left by discard, for the recording to find once it stops
discard="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickbar/discard-recording"

record() {
    local file="$HOME/Videos/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S').mp4"
    rm -f "$discard"
    tray run --id screenrecord --icon record --tooltip "Recording the screen" --duration \
        --on-click "$self stop" \
        --menu "Stop and save=$self stop" \
        --menu "Discard=$self discard" \
        --menu - \
        --menu "Show recordings=uwsm app -- ghostty --title=yazi -e yazi $HOME/Videos" \
        -- wl-screenrec -f "$file" --ffmpeg-encoder-options="-c:v libx264 -crf 23 -preset medium -movflags +faststart" "$@"
    if [[ -f "$discard" ]]; then
        rm -f "$discard" "$file"
        notify-send -a "Screen recording" -n simplescreenrecorder -t 2000 "Recording discarded"
    elif [[ -f "$file" ]]; then
        setsid -f "$(dirname "$self")/capture-notify" recording "$file" >/dev/null 2>&1
    fi
}

case "$1" in
screen)
    record --output "$(hyprctl monitors -j | jq -r '.[] | select(.focused).name')"
    ;;
region)
    region=$(slurp) || exit 1
    record -g "$region"
    ;;
window)
    workspace=$(hyprctl activeworkspace -j | jq -r '.id')
    region=$(hyprctl clients -j | jq -r --argjson ws "$workspace" \
        '.[] | select(.workspace.id == $ws) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | slurp) || exit 1
    record -g "$region"
    ;;
stop)
    pkill -x wl-screenrec
    ;;
discard)
    mkdir -p "${discard%/*}"
    pgrep -x wl-screenrec >/dev/null && touch "$discard"
    pkill -x wl-screenrec
    ;;
*)
    echo "usage: screenrecord screen|region|window|stop|discard" >&2
    exit 2
    ;;
esac
