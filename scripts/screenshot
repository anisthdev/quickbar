#!/usr/bin/env bash
# quickbar's screenshot (modules/Capture.qml): saved by hyprshot to
# ~/Pictures and copied, with the shutter sound, then a notification with
# what to do with it next (scripts/capture-notify).
#   screenshot screen   the focused screen
#   screenshot region   a region picked with the mouse
#   screenshot window   a window picked with the mouse
#   screenshot timer    the focused screen after a 5 s countdown

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")"
name="$(date +%Y-%m-%d-%H%M%S)_hyprshot.png"

# hyprshot's own notification is left out for ours; without it hyprshot
# exits 1 even when it saved, so the file says whether it did
shot() {
    hyprshot --silent -o "$dir" -f "$name" "$@"
}

# The sound, and the notification once the file is there (a cancelled
# pick leaves none)
shutter() {
    [[ -f "$dir/$name" ]] || return 0
    pw-play ~/.local/share/sounds/macos/camera-shutter.ogg &
    setsid -f "$(dirname "$(realpath "$0")")/capture-notify" screenshot "$dir/$name" >/dev/null 2>&1
}

# One card counting down in place (each lasts past the next, which takes it
# over), closed before the shot
countdown() {
    local id
    for sec in $(seq "$1" -1 1); do
        id=$(notify-send -p -t 2000 \
            --hint=string:x-canonical-private-synchronous:shot \
            "Taking shot in : $sec")
        sleep 1
    done
    gdbus call --session --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.CloseNotification "$id" >/dev/null
    sleep 0.4
}

case "$1" in
screen) shot -m active -m output; shutter ;;
region) shot -m region; shutter ;;
window) shot -m window; shutter ;;
timer) countdown 5 && shot -m active -m output; shutter ;;
*)
    echo "usage: screenshot screen|region|window|timer" >&2
    exit 2
    ;;
esac
