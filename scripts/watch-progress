#!/usr/bin/env python3
"""mpv's playback progress, for the library (modules/Reel.qml), as JSON:

  {"resume": {WATCH_LATER_NAME: [position, mtime], ...},
   "played": {PATH: time, ...}}

resume: where each file stopped (mpv's watch_later files, save-position-on-quit)
and when; played: when each file last played (mpv's watch history,
save-watch-history).
"""
import json
import sys
import os
from pathlib import Path

state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "mpv"

resume = {}
try:
    entries = list(os.scandir(state / "watch_later"))
except FileNotFoundError:
    entries = []
for entry in entries:
    try:
        with open(entry.path) as f:
            for line in f:
                if line.startswith("start="):
                    resume[entry.name] = [float(line[6:]), int(entry.stat().st_mtime)]
                    break
    except (OSError, ValueError):
        pass

played = {}
try:
    with open(state / "watch_history.jsonl") as f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("path") and e.get("time", 0) > played.get(e["path"], 0):
                played[e["path"]] = e["time"]
except FileNotFoundError:
    pass

json.dump({"resume": resume, "played": played}, sys.stdout)
